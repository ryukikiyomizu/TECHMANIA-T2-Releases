{
  "name": "mxgg-techmania-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Startup launcher and updater for TECHMANIA and the T2 theme",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && set ELECTRON_BUILDER_COMPRESSION_LEVEL=1&& electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "animejs": "4.5.0"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "gg.mxgg.techmania.launcher",
    "productName": "TECHMANIA Launcher",
    "artifactName": "TECHMANIA-Launcher.${ext}",
    "asar": true,
    "compression": "normal",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "useZip": true
    }
  }
}
